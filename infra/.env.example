# ==============================
# ВИЖУ — переменные окружения
# cp .env.example .env и заполни
# .env никогда не коммитится!
# ==============================

# GitHub Container Registry — владелец пакетов ghcr.io/<owner>/vizhu-*.
GHCR_OWNER=

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# JWT
JWT_SECRET=change_me_random_256bit_string

# SMSC (smsc.ru) — отправка SMS
# Личный кабинет smsc.ru → Настройки → API-ключ
SMSC_API_KEY=

# Фиксированный код входа для локальной разработки: ровно 4 цифры.
# При NODE_ENV=production игнорируется, чтобы не стать универсальным паролем.
OTP_BYPASS=1234

# GigaChat (Сбер Dev Portal)
# https://developers.sber.ru/portal/products/gigachat
# Как получить GIGACHAT_CREDENTIALS:
#   1. Личный кабинет → проект → "Авторизационные данные" → скопируй Client ID и Secret Key
#   2. echo -n "CLIENT_ID:SECRET_KEY" | base64
GIGACHAT_CREDENTIALS=

# Yandex Cloud
# https://console.yandex.cloud → IAM → сервисный аккаунт
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# LiveKit (WebRTC).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Хранилище состояния матчинга звонков: memory (в памяти процесса, теряется
# при рестарте api) или redis (переживает рестарт). Переключается без
# пересборки — правкой этой переменной и `docker compose up -d api`.
MATCHING_BACKEND=memory
