# ==============================
# ВИЖУ — переменные окружения
# cp .env.example .env и заполнить
# ==============================

#креды от гигачата
GIGACHAT_CREDENTIALS=рандомныйнаборбуквицифр

#имя папки на яндекс облаке и апи-ключ
YANDEX_FOLDER_ID=рандомныйнаборбуквицифр
YANDEX_API_KEY=рандомныйнаборбуквицифр

#овнер репки для ci-cd
GHCR_OWNER=юзернеймгитхаба

# Фиксированный код входа для локальной разработки: ровно 4 цифры.
# При NODE_ENV=production игнорируется, чтобы не стать универсальным паролем.
OTP_BYPASS=1234

# Yandex Postbox — отправка писем (SES-совместимый API).
POSTBOX_API_KEY=
POSTBOX_API_SECRET=

# Отправитель. Адрес должен быть подтверждён в Postbox, иначе письма не уйдут.
POSTBOX_FROM=ВИЖУ <no-reply@vizhu.su>

# Базовый адрес приложения — из него собирается ссылка в письме:
# $APP_URL/magic-link?token=... Должен совпадать с доменом, где живёт фронт.
APP_URL=https://app.vizhu.su
#апи-ключ для смс-центра
SMSC_API_KEY=uuid

#пароль от бд в постгресе
POSTGRES_PASSWORD=рандомныйнаборбуквицифр

#подпись jwt
JWT_SECRET=рандомныйнаборбуквицифр

#апи-ключ системы webrtc и ее секрет
LIVEKIT_API_KEY=рандомныйнаборбуквицифр
LIVEKIT_API_SECRET=рандомныйнаборбуквицифр

#выбор способа работы матчинга - через Map или через Redis
MATCHING_BACKEND=memory|redis
