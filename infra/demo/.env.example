# ==============================
# Демо-стенд demo.vizhu.su
# ./demo.sh up сам создаст .env из этого набора: ключи внешних сервисов
# скопирует из infra/.env (прода), пароль БД и JWT_SECRET сгенерирует новые.
# Руками править, только если нужно что-то отличное от прода.
# ==============================

# Свои, НЕ как на проде
POSTGRES_PASSWORD=
JWT_SECRET=

# Запасной код входа, если звонок не дошёл. Ровно 4 цифры.
# Фронт показывает его на экране «Это демо-версия» — после смены нужен ./demo.sh up.
DEMO_OTP_CODE=8153

# Копируются из infra/.env
SMSC_API_KEY=
GIGACHAT_CREDENTIALS=
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
POSTBOX_API_KEY=
POSTBOX_API_SECRET=
POSTBOX_FROM=

# Необязательно. Если сервер не достучится сам до себя по публичному адресу
# (hairpin NAT), комнаты LiveKit не создадутся — тогда см. README.md.
# LIVEKIT_HOST=https://rtc.vizhu.su
