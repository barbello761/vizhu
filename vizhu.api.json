          "role": {
            "type": "string",
            "enum": [
              "blind",
              "volunteer"
            ],
            "example": "blind",
            "description": "Роль пользователя — незрячий или волонтёр"
          },
          "email": {
            "type": "object",
            "example": "user@example.com",
            "description": "Резервная почта. Сохраняется неподтверждённой, письмо со ссылкой уходит сразу — регистрация его не ждёт"
          }
        },
        "required": [
          "name",
          "role"
        ]
      },
      "UpdateProfileBody": {
        "type": "object",
        "properties": {
