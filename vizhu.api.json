        "responses": {
          "201": {
            "description": "{ id, email, expiresAt }"
          },
          "400": {
            "description": "\u041d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438\u043b\u0438 \u043d\u0435\u0442 \u0430\u0434\u0440\u0435\u0441\u0430"
          },
          "409": {
            "description": "\u0423 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u043d\u0435\u0442 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u044b"
          },
          "429": {
            "description": "\u041f\u0438\u0441\u044c\u043c\u043e \u0443\u0436\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043c\u0438\u043d\u0443\u0442\u0443 \u043d\u0430\u0437\u0430\u0434"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u043f\u0438\u0441\u044c\u043c\u043e \u0441\u043e \u0441\u0441\u044b\u043b\u043a\u043e\u0439 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f",
        "tags": [
          "email"
        ]
      }
    },
    "/email/verifications/confirm": {
      "post": {
        "operationId": "MailController_confirm",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmVerificationBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ purpose }"
          },
          "400": {
            "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u0430 \u0438\u043b\u0438 \u0438\u0441\u0442\u0435\u043a\u043b\u0430"
          }
        },
        "summary": "\u041e\u0442\u043c\u0435\u0442\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0445\u043e\u0434 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 \u0438\u0437 \u043f\u0438\u0441\u044c\u043c\u0430",
        "tags": [
          "email"
        ]
      }
    },
    "/email/verifications/{id}": {
      "get": {
        "operationId": "MailController_status",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "status: pending | confirmed | consumed | expired"
          },
          "404": {
            "description": "\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "\u0421\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u2014 \u0437\u0430 \u044d\u0442\u0438\u043c \u0445\u043e\u0434\u0438\u0442 \u00ab\u042f \u043f\u0435\u0440\u0435\u0448\u0451\u043b \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435\u00bb",
        "tags": [
          "email"
        ]
      }
    },
    "/calls/token": {
      "post": {
        "operationId": "CallsController_getToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": [
          "calls"
        ]
      }
    },
    "/calls/availability": {
      "get": {
        "operationId": "CallsController_getAvailability",
        "parameters": [],
        "responses": {
          "200": {
            "description": "{ available: number }"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0432\u043e\u043b\u043e\u043d\u0442\u0451\u0440\u043e\u0432 \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b \u0438 \u0433\u043e\u0442\u043e\u0432\u044b \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0437\u0432\u043e\u043d\u043e\u043a",
        "tags": [
          "calls"
        ]
      }
    }
  },
  "info": {
    "title": "\u0412\u0418\u0416\u0423 API",
    "description": "API \u0434\u043b\u044f \u0441\u0435\u0440\u0432\u0438\u0441\u0430 \u043f\u043e\u043c\u043e\u0449\u0438 \u043d\u0435\u0437\u0440\u044f\u0447\u0438\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f\u043c",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "RenameHistoryBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "object",
            "example": "\u041a\u0432\u0438\u0442\u0430\u043d\u0446\u0438\u044f \u0416\u041a\u0425",
            "description": "\u041d\u043e\u0432\u043e\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0437\u0430\u043f\u0438\u0441\u0438, \u0434\u043e 255 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432"
          }
        },
        "required": [
          "title"
        ]
      },
      "SendOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430. \u041f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442\u0441\u044f \u043b\u044e\u0431\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u0442: 79001234567, +7(900)123-45-67, 8-900-123-45-67"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "\u041d\u043e\u043c\u0435\u0440 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0430 \u0432 \u043b\u044e\u0431\u043e\u043c \u0444\u043e\u0440\u043c\u0430\u0442\u0435"
          },
          "code": {
            "type": "object",
            "example": "1234",
            "description": "4-\u0437\u043d\u0430\u0447\u043d\u044b\u0439 \u043a\u043e\u0434 \u0438\u0437 \u0437\u0432\u043e\u043d\u043a\u0430"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshBody": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "object",
            "description": "Refresh token \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u043d\u0430\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (X-Client: native). Web \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 httpOnly-\u043a\u0443\u043a\u0443."
          }
        }
      },
      "CreateProfileBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "example": "\u0418\u0432\u0430\u043d",
            "description": "\u0418\u043c\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
          },
          "role": {
            "type": "string",
            "enum": [
              "blind",
              "volunteer"
            ],
            "example": "blind",
            "description": "\u0420\u043e\u043b\u044c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u2014 \u043d\u0435\u0437\u0440\u044f\u0447\u0438\u0439 \u0438\u043b\u0438 \u0432\u043e\u043b\u043e\u043d\u0442\u0451\u0440"
          },
          "email": {
            "type": "object",
            "example": "user@example.com",
            "description": "\u0420\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043f\u043e\u0447\u0442\u0430. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043d\u0435\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u043e\u0439, \u043f\u0438\u0441\u044c\u043c\u043e \u0441\u043e \u0441\u0441\u044b\u043b\u043a\u043e\u0439 \u0443\u0445\u043e\u0434\u0438\u0442 \u0441\u0440\u0430\u0437\u0443 \u2014 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0435\u0433\u043e \u043d\u0435 \u0436\u0434\u0451\u0442"
          }
        },
        "required": [
          "name",
          "role"
        ]
      },
      "UpdateProfileBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "example": "\u0418\u0432\u0430\u043d",
            "description": "\u041d\u043e\u0432\u043e\u0435 \u0438\u043c\u044f, \u043e\u0442 2 \u0434\u043e 255 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432"
          }
        }
      },
      "ConfirmedActionBody": {
        "type": "object",
        "properties": {
          "verificationId": {
            "type": "object",
            "description": "id \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u0438\u0437 POST /email/verifications, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0443\u0436\u0435 \u043f\u0435\u0440\u0435\u0448\u043b\u0438 \u043f\u043e \u0441\u0441\u044b\u043b\u043a\u0435 \u0438\u0437 \u043f\u0438\u0441\u044c\u043c\u0430"
          }
        },
        "required": [
          "verificationId"
        ]
      },
      "SendPhoneOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "\u041d\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440, \u043b\u044e\u0431\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u0442"
          }
        },
        "required": [
          "phone"
        ]
      },
      "ChangePhoneBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "\u041d\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440, \u043b\u044e\u0431\u043e\u0439 \u0444\u043e\u0440\u043c\u0430\u0442"
          },
          "code": {
            "type": "object",
            "example": "1234",
            "description": "4-\u0437\u043d\u0430\u0447\u043d\u044b\u0439 \u043a\u043e\u0434 \u0438\u0437 \u0437\u0432\u043e\u043d\u043a\u0430 \u043d\u0430 \u043d\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440"
          },
          "verificationId": {
            "type": "object",
            "description": "id \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f \u043f\u043e \u043f\u0438\u0441\u044c\u043c\u0443 (purpose=change_phone)"
          }
        },
        "required": [
          "phone",
          "code",
          "verificationId"
        ]
      },
      "DeleteProfileBody": {
        "type": "object",
        "properties": {
          "verificationId": {
            "type": "object",
            "description": "id \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f. \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u0435\u043d, \u0435\u0441\u043b\u0438 \u0443 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430 \u0435\u0441\u0442\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u0430\u044f \u043f\u043e\u0447\u0442\u0430"
          }
        }
      },
      "RequestVerificationBody": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "verify_email",
              "change_email",
              "change_phone",
              "delete_account"
            ],
            "example": "change_email",
            "description": "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044f \u043f\u0438\u0441\u044c\u043c\u043e\u043c"
          },
          "email": {
            "type": "object",
            "example": "user@example.com",
            "description": "\u041d\u043e\u0432\u044b\u0439 \u0430\u0434\u0440\u0435\u0441. \u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u0435\u043d \u0438 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f change_email \u2014 \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0442\u0441\u044f \u043f\u0438\u0441\u044c\u043c\u043e\u043c \u043d\u0430 \u043f\u043e\u0447\u0442\u0443 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "ConfirmVerificationBody": {
        "type": "object",
        "properties": {
          "token": {
            "type": "object",
            "description": "\u0422\u043e\u043a\u0435\u043d \u0438\u0437 \u0441\u0441\u044b\u043b\u043a\u0438 \u0432 \u043f\u0438\u0441\u044c\u043c\u0435 (query-\u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 token)"
          }
        },
        "required": [
          "token"
        ]
      },
      "CreateTokenDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
