  "info": {
    "title": "ВИЖУ API",
    "description": "API для сервиса помощи незрячим пользователям",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "RenameHistoryBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "object",
            "example": "Квитанция ЖКХ",
            "description": "Новое название записи, до 255 символов"
          }
        },
        "required": [
          "title"
        ]
      },
      "SendOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "Номер телефона. Принимается любой формат: 79001234567, +7(900)123-45-67, 8-900-123-45-67"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "Номер телефона в любом формате"
          },
          "code": {
            "type": "object",
            "example": "1234",
            "description": "4-значный код из звонка"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "RefreshBody": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "object",
            "description": "Refresh token — только для нативного клиента (X-Client: native). Web использует httpOnly-куку."
          }
        }
      },
      "SessionView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deviceName": {
            "type": "string",
            "example": "Pixel 7",
            "description": "Подпись устройства"
          },
          "client": {
            "type": "string",
            "enum": [
              "native",
              "web"
            ],
            "description": "Приложение или браузер"
          },
          "platform": {
            "type": "string",
            "enum": [
              "android",
              "ios",
              "windows",
              "macos",
              "linux",
              "unknown"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Когда вошли"
          },
          "lastActiveAt": {
            "type": "string",
            "format": "date-time",
            "description": "Последнее обновление токенов"
          }
        },
        "required": [
          "id",
          "deviceName",
          "client",
          "platform",
          "createdAt",
          "lastActiveAt"
        ]
      },
      "SessionsListView": {
        "type": "object",
        "properties": {
          "current": {
            "description": "Сеанс этого устройства",
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionView"
              }
            ]
          },
          "others": {
            "description": "Остальные активные сеансы, свежие сверху",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionView"
            }
          }
        },
        "required": [
