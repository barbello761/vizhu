        },
        "required": [
          "phone"
        ]
      },
      "ChangePhoneBody": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "object",
            "example": "79001234567",
            "description": "Новый номер, любой формат"
          },
          "code": {
            "type": "object",
            "example": "1234",
            "description": "4-значный код из звонка на новый номер"
          },
          "verificationId": {
            "type": "object",
            "description": "id подтверждения по письму (purpose=change_phone)"
          }
        },
        "required": [
