# npm run dev БЕЗ докера. В докерном деве перебивается через environment:
# в infra/docker-compose.dev.yml.

# Относительный путь, как в .env.production: один origin, без CORS.
VITE_API_URL=/api

# Куда vite-прокси шлёт /api и /socket.io. Прод сюда — только осознанно.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Пусто → origin страницы, то есть тот же vite-прокси.
VITE_SOCKET_URL=

VITE_API_TIMEOUT=15000
VITE_APP_TITLE=ВИЖУ (dev)
VITE_APP_ENV=development
VITE_ENABLE_DEVTOOLS=true

# MSW-моки вместо настоящего бэкенда. true — работа над UI без поднятого api.
VITE_ENABLE_MOCKS=false
