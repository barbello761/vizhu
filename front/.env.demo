# Демо-стенд demo.vizhu.su — used by: npm run build:demo
# Собирается образом из infra/demo/docker-compose.yml. От production отличается
# только демо-флагом: фронт, api и сокет живут на одном origin за nginx.

VITE_API_URL=/api
VITE_API_TIMEOUT=30000
VITE_APP_TITLE=ВИЖУ (демо)
VITE_APP_ENV=production
VITE_ENABLE_DEVTOOLS=false
# Пусто → origin страницы: сокет демо-стенда, а не app.vizhu.su.
VITE_SOCKET_URL=
VITE_ENABLE_MOCKS=false

VITE_DEMO_MODE=true
# Перебивается build-arg'ом из DEMO_OTP_CODE в infra/demo/.env.
VITE_DEMO_OTP_CODE=8153
