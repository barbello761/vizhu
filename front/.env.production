# Production environment — used by: npm run build
# VITE_API_URL — относительный путь, проксируется Nginx на бэкенд.
# При переносе API на поддомен: поменять на https://api.vizhu.su
# (и обновить urlPattern в vite.config.ts)

VITE_API_URL=/api
VITE_API_TIMEOUT=30000
VITE_APP_TITLE=ВИЖУ
VITE_APP_ENV=production
VITE_ENABLE_DEVTOOLS=false
VITE_SOCKET_URL=https://app.vizhu.su
VITE_ENABLE_MOCKS=false